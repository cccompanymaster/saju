# ── 서버 ──
PORT=3000
READING_PRICE=3900

# ── AI (Anthropic Claude) ──
# 없으면 mock 으로 동작. https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_EFFORT=high

# ── TossPayments ──
# https://docs.tosspayments.com — 대시보드에서 발급
# 없으면 결제는 mock 승인(개발용). 실서비스에선 반드시 설정.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 이메일 발송 (SMTP) ──
# 없으면 mock(콘솔 로그). 예: 네이버웍스/구글/SES
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="마녀의 리뷰 <no-reply@majatalk.com>"

# ── 앱 기본 URL (재열람 링크 생성용) ──
APP_BASE_URL=https://basic.majatalk.com

# ── 카카오 로그인(회원가입) + 채널 ──
# JS 키: 카카오 개발자 콘솔. 채널 ID: '_xxxxx' (pf.kakao.com/_xxxxx)
KAKAO_JS_KEY=
KAKAO_CHANNEL_ID=

# ── 카카오 알림톡 (Solapi 대행사) ──
# 비즈채널·템플릿 사전 승인 필요. 미설정 시 mock.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
KAKAO_PFID=
KAKAO_TEMPLATE_ID=
