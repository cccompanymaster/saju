# ── 서버 ──
PORT=3000
READING_PRICE=3900

# ── AI (Google Gemini) ──
# 없으면 mock 으로 동작. https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── TossPayments ──
# https://docs.tosspayments.com — 대시보드에서 발급
# 없으면 결제는 mock 승인(개발용). 실서비스에선 반드시 설정.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 이메일 발송 (SMTP) ──
# 없으면 mock(콘솔 로그). 예: 네이버웍스/구글/SES
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="마녀의 리뷰 <no-reply@majatalk.com>"

# ── 카카오 알림톡 (선택) ──
# 비즈채널·템플릿 승인 필요. 없으면 mock.
KAKAO_ALIMTALK_TOKEN=
